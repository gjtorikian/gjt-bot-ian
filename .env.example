# Install App → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information → App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-...
# Your Slack member ID. Profile → ⋮ → Copy member ID. Comma-separated for more.
SLACK_ALLOWED_USERS=U000000000

# Console logging: info = activity/results; debug = full prompts + streamed tool output; silent = off.
BOT_LOG_LEVEL=info
# Log colors are automatic in terminals. NO_COLOR=1 disables them; FORCE_COLOR=1 enables them in pipes.
