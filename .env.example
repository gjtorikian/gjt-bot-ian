# Install App → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information → App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-...
# Your Slack member ID. Profile → ⋮ → Copy member ID. Comma-separated for more.
SLACK_ALLOWED_USERS=U000000000

# Optional per-request timeout in milliseconds (default: 15 minutes).
# BOT_TIMEOUT_MS=900000

# Console logging: info = activity/results; debug = full prompts + streamed tool output; silent = off.
BOT_LOG_LEVEL=info
# Log colors are automatic in terminals. NO_COLOR=1 disables them; FORCE_COLOR=1 enables them in pipes.

# Optional local notifications. Leave all three unset to disable the HTTP listener.
# See README.md to generate a separate random token without printing it.
# BOT_LOCAL_API_PORT=3210
# BOT_LOCAL_API_TOKEN=<64 lowercase hex characters from 32 random bytes>
# Required only when SLACK_ALLOWED_USERS contains more than one user.
# BOT_LOCAL_API_USER=U000000000
